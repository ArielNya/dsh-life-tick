{
  "name": "dsh-life-tick",
  "description": "Irregular companion life-ticks for DeepSeek Harness: Poisson wakes, silent/private/dream/glance/reach lottery, home-preset only.",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "types/**",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "heartbeat",
    "life-tick",
    "companion",
    "proactive",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArielNya/dsh-life-tick.git"
  },
  "bugs": {
    "url": "https://github.com/ArielNya/dsh-life-tick/issues"
  },
  "homepage": "https://github.com/ArielNya/dsh-life-tick#readme"
}
